# Copy to .env.local and fill in. Never commit real keys.

# AI provider (server-only). Without any key the assistant runs in scripted mock mode.
# Optional: force one of deepseek | claude | mock
# AI_PROVIDER=

# DeepSeek (OpenAI-compatible). Used first when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Claude API
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase: real accounts (email code, Google). Without these, live sign-in is imitated in the browser.
# Publishable key: Supabase dashboard → Project Settings → API Keys. Safe in the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Length of the email code set in Supabase → Authentication → Providers → Email (default 6)
# NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6
# Server-only (payment webhook, later): never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# FreedomPay (server-only, lib/payments/freedompay). Merchant cabinet → merchant id and keys.
# Payment key signs payments; the payout key signs payouts (separate). Never prefix with NEXT_PUBLIC_
# FREEDOMPAY_MERCHANT_ID=
# FREEDOMPAY_SECRET_KEY=
# FREEDOMPAY_PAYOUT_SECRET_KEY=
# FREEDOMPAY_API_URL=https://api.freedompay.kg
# 1 = test payments (pg_testing_mode), test cards in docs.freedompay.kz
# FREEDOMPAY_TESTING=1
# Public base url for FreedomPay callbacks/returns (must be reachable from the internet; default: request origin)
# PAYMENTS_PUBLIC_URL=https://www.eventusai.app
# Checkout uses FreedomPay instead of the simulation (live mode). Only once bookings live in Supabase.
# NEXT_PUBLIC_PAYMENT_PROVIDER=freedompay

# Product analytics (PostHog, EU cloud). Loads only after the visitor allows analytics in the cookie banner.
# Project API key from https://eu.posthog.com → Project settings. Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Log every analytics call to the browser console (works without a key)
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
