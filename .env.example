# Copy to .env.local and fill in. Never commit real keys.

# AI provider (server-only). Without any key the assistant runs in scripted mock mode.
# Optional: force one of deepseek | claude | mock
# AI_PROVIDER=

# DeepSeek (OpenAI-compatible). Used first when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Claude API
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# Future: Supabase (not used by the mock demo yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Future: real payment provider (see lib/payments/provider.ts)
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
