# Copy to .env.local and fill in. Never commit real keys.

# Claude API (server-only). Without it the assistant runs in scripted mock mode.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

