{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./tsconfig.tsbuildinfo)",
      "Read(./.next/**)",
      "Read(./.vercel/**)",
      "Read(./.claude/worktrees/**)",
      "Read(./public/brand/logo-original.png)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\"" }
        ]
      }
    ]
  }
}
